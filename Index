};

/* Normalização de nomes */
const NORM = {
  'Leo':'Léo','Leonardo':'Léo','leo':'Léo','Léo':'Léo',
  'Malu':'Malu','Franklin':'Franklin',
  'Julia':'Júlia','Júlia':'Júlia',
